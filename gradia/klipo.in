import os
import sys
import signal
import locale
import gettext
import logging
import gi
logging.getLogger("PIL").setLevel(logging.WARNING)
VERSION = '@VERSION@'
pkgdatadir = '@PKGDATA_DIR@'
localedir = '@LOCALE_DIR@'
sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('klipo', localedir)
locale.textdomain('klipo')
gettext.install('klipo', localedir)

if __name__ == '__main__':
    # Screenshots are taken by the primary instance (see main.py), so that
    # a command sent to an already running Klipo reuses its editor window.
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    gi.require_version('Xdp', '1.0')
    from gi.repository import Gio, GLib

    GLib.set_prgname("klipo")
    resource = Gio.Resource.load(
        os.path.join(pkgdatadir, 'klipo.gresource'))
    resource._register()
    from gradia import main
    sys.exit(main.main(VERSION))
