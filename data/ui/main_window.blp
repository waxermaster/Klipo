using Gtk 4.0;
using Adw 1;

template $GradiaMainWindow: Adw.ApplicationWindow {
  title: "Klipo";
  default-width: 1100;
  default-height: 720;

  content: Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView toolbar_view {
      top-bar-style: raised;

      [top]
      Adw.HeaderBar header_bar {
        title-widget: Adw.WindowTitle {
          title: "Klipo";
        };
      }

      [top]
      Gtk.Box action_bar {
        spacing: 12;
        margin-start: 12;
        margin-end: 12;
        margin-top: 6;
        margin-bottom: 6;

        Gtk.Box {
          styles [
            "linked",
          ]

          Gtk.Button {
            icon-name: "alarm-symbolic";
            tooltip-text: _("Delay before capturing");
            sensitive: false;
          }

          Gtk.DropDown delay_dropdown {
            tooltip-text: _("Delay before capturing");

            model: Gtk.StringList {
              strings [
                _("0 s"),
                _("3 s"),
                _("5 s"),
                _("10 s"),
              ]
            };
          }
        }

        Gtk.Box capture_box {
          styles [
            "linked",
          ]

          Gtk.Button {
            action-name: "win.capture-area";
            tooltip-text: _("Select an area to capture (Ctrl+A)");

            child: Adw.ButtonContent {
              icon-name: "screenshooter-symbolic";
              label: _("Area");
            };
          }

          Gtk.Button {
            action-name: "win.capture-window";
            tooltip-text: _("Capture the active window");

            child: Adw.ButtonContent {
              icon-name: "focus-windows-symbolic";
              label: _("Window");
            };
          }

          Gtk.Button {
            action-name: "win.capture-screen";
            tooltip-text: _("Capture the screen under the pointer");

            child: Adw.ButtonContent {
              icon-name: "video-display-symbolic";
              label: _("Screen");
            };
          }

          Gtk.Button {
            action-name: "win.capture-all";
            tooltip-text: _("Capture all screens");

            child: Adw.ButtonContent {
              icon-name: "view-dual-symbolic";
              label: _("All Screens");
            };
          }

          Gtk.Button {
            action-name: "win.record";
            tooltip-text: _("Record the screen");

            child: Adw.ButtonContent {
              icon-name: "camera-video-symbolic";
              label: _("Video");
            };
          }
        }

        Gtk.Box {
          hexpand: true;
        }

        Gtk.Button {
          tooltip-text: _("Copy to Clipboard (Ctrl+C)");
          action-name: "win.copy";

          child: Adw.ButtonContent {
            icon-name: "edit-copy-symbolic";
            label: _("_Copy");
            use-underline: true;
          };

          styles [
            "suggested-action",
          ]
        }

        Gtk.Button {
          tooltip-text: _("Save to the default folder (Ctrl+S)");
          action-name: "win.save";

          child: Adw.ButtonContent {
            icon-name: "document-save-symbolic";
            label: _("_Save");
            use-underline: true;
          };
        }

        Gtk.Button {
          tooltip-text: _("Choose where to save (Ctrl+Shift+S)");
          action-name: "win.save-as";

          child: Adw.ButtonContent {
            icon-name: "document-save-as-symbolic";
            label: _("Save _As");
            use-underline: true;
          };
        }

        Gtk.Button share_button {
          icon-name: "share-symbolic";
          tooltip-text: _("Share Image (Ctrl+M)");
          action-name: "win.command";
          visible: false;
        }

        Gtk.MenuButton main_menu_button {
          icon-name: "view-more-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: app_menu;
          primary: true;

          styles [
            "flat",
          ]
        }
      }

      [top]
      Gtk.Box {
        orientation: vertical;

        Adw.TabBar tab_bar {
          view: tab_view;
          autohide: false;
        }

        // Only used as the tab model: the editor below is shared by all tabs
        Adw.TabView tab_view {
          visible: false;
        }
      }

      [bottom]
      Gtk.Box status_bar {
        spacing: 6;
        margin-start: 12;
        margin-end: 12;
        margin-top: 4;
        margin-bottom: 4;

        Gtk.Label image_size_label {
          xalign: 0;

          styles [
            "dim-label",
            "numeric",
          ]
        }

        Gtk.Box {
          hexpand: true;
        }

        Gtk.Button {
          icon-name: "zoom-out-symbolic";
          tooltip-text: _("Zoom Out (Ctrl+−)");
          action-name: "win.zoom-out";

          styles [
            "flat",
          ]
        }

        Gtk.Button zoom_percent_button {
          tooltip-text: _("Actual Size (Ctrl+1)");
          action-name: "win.zoom-actual-size";
          label: "100 %";
          width-request: 70;

          styles [
            "flat",
            "numeric",
          ]
        }

        Gtk.Button {
          icon-name: "zoom-in-symbolic";
          tooltip-text: _("Zoom In (Ctrl++)");
          action-name: "win.zoom-in";

          styles [
            "flat",
          ]
        }

        Gtk.Button {
          tooltip-text: _("Fit to Window (Ctrl+0)");
          action-name: "win.reset-zoom";

          child: Adw.ButtonContent {
            icon-name: "zoom-fit-best-symbolic";
            label: _("Fit");
          };

          styles [
            "flat",
          ]
        }
      }

      content: Gtk.Stack main_stack {
        transition-type: crossfade;
        transition-duration: 200;

        Adw.Bin welcome_page {
          name: "welcome";

          child: Box welcome_content_placeholder {};
        }

        Gtk.StackPage main_page {
          name: "main";

          child: Gtk.Box editor_box {
            orientation: horizontal;

            Gtk.ScrolledWindow tool_rail_scroller {
              hscrollbar-policy: never;
              propagate-natural-width: true;

              child: Gtk.Box tool_rail {
                orientation: vertical;
                spacing: 4;
                margin-top: 6;
                margin-bottom: 6;
                margin-start: 6;
                margin-end: 6;

                styles [
                  "tool-rail",
                ]
              };
            }

            Gtk.Separator {
              orientation: vertical;
            }

            Adw.BreakpointBin breakpoint_bin {
              width-request: 200;
              height-request: 50;
              hexpand: true;

              Adw.Breakpoint breakpoint {
                condition ("max-width: 640sp")

                setters {
                  split_view.collapsed: true;
                }
              }

              child: Adw.OverlaySplitView split_view {
                collapsed: false;
                show-sidebar: true;
                sidebar-position: end;
                min-sidebar-width: 300;
                max-sidebar-width: 360;
              };
            }
          };
        }
      };
    }
  };
}

menu app_menu {
  section {
    item {
      label: _("_Open Image…");
      action: "win.open";
    }

    item {
      label: _("_Paste Image");
      action: "win.paste";
    }

    item {
      label: _("Open Containing _Folder");
      action: "win.open-folder";
    }
  }

  section {
    item {
      label: _("_Pin Image on Screen");
      action: "win.pin";
    }

    item {
      label: _("_Upload / Share…");
      action: "win.command";
    }

    item {
      label: _("Clear All _Annotations");
      action: "win.clear";
    }

    item {
      label: _("Recognize _Text");
      action: "win.ocr";
    }

    item {
      label: _("_Source Snippets");
      action: "win.create-source-image";
    }

    item {
      label: _("_Delete Taken Screenshot(s)");
      action: "win.delete-screenshots";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.shortcuts";
    }

    item {
      label: _("D_onate to Gradia");
      action: "win.donate";
    }

    item {
      label: _("_About Klipo");
      action: "win.about";
    }
  }
}
