using Gtk 4.0;

template $GradiaDrawingToolsGroup: Box {
  orientation: vertical;

  Text {
    text: _("Tool Properties");
    margin-bottom: 12;
    sensitive: false;

    styles [
      "heading",
      "h4",
    ]
  }

  $GradiaDrawingToolsGrid drawing_tools_grid {
    tool-changed => $on_tool_changed();
  }

  Label {
    label: _("Color");
    xalign: 0;

    styles [
      "caption-heading",
      "dim-label",
    ]
  }

  $GradiaQuickColorPicker color_picker {
    margin-top: 6;
    color-changed => $on_primary_color_changed();
  }

  Label {
    label: _("Size");
    xalign: 0;
    margin-top: 12;

    styles [
      "caption-heading",
      "dim-label",
    ]
  }

  Scale size_scale {
    orientation: horizontal;
    margin-top: 6;

    adjustment: Adjustment {
      value-changed => $on_size_scale_changed();
      lower: 3;
      upper: 25;
      value: 14;
      step-increment: 2;
    };
  }

  Label opacity_label {
    label: _("Opacity");
    xalign: 0;
    margin-top: 12;

    styles [
      "caption-heading",
      "dim-label",
    ]
  }

  Scale opacity_scale {
    orientation: horizontal;
    margin-top: 6;
    draw-value: true;
    value-pos: right;
    digits: 0;

    adjustment: Adjustment {
      value-changed => $on_opacity_changed();
      lower: 10;
      upper: 100;
      value: 100;
      step-increment: 5;
      page-increment: 10;
    };
  }

  Revealer extra_stack_revealer {
    reveal-child: true;
    transition-type: slide_up;
    transition-duration: 200;
    valign: start;

    child: Stack extra_stack {
      transition-type: crossfade;
      transition-duration: 200;

      StackPage {
        name: "empty";

        child: Box {
          visible: true;
        };
      }

      StackPage {
        name: "fill";

        child: Box {
          spacing: 8;
          homogeneous: true;
          margin-top: 6;

          $GradiaSimpleColorPicker fill_0 {
            icon-name: "fill-symbolic";
            text: _("Fill");
            hexpand: true;
            color-changed => $on_fill_color_changed();
          }
        };
      }

      StackPage {
        name: "fill-border";

        child: Box {
          spacing: 8;
          homogeneous: true;
          margin-top: 6;

          $GradiaSimpleColorPicker fill_1 {
            icon-name: "fill-symbolic";
            text: _("Fill");
            hexpand: true;
            color-changed => $on_fill_color_changed();
          }

          $GradiaSimpleColorPicker outline_1 {
            icon-name: "outline-color-symbolic";
            text: _("Border");
            hexpand: true;
            color-changed => $on_outline_color_changed();
          }
        };
      }

      StackPage {
        name: "text";

        child: Box {
          spacing: 6;
          margin-top: 6;

          $GradiaSimpleColorPicker fill_2 {
            icon-name: "fill-symbolic";
            hexpand: true;
            color-changed => $on_fill_color_changed();
            tooltip-text: _("Fill Color Picker");
          }

          $GradiaSimpleColorPicker outline_2 {
            icon-name: "outline-color-symbolic";
            hexpand: true;
            color-changed => $on_outline_color_changed();
            tooltip-text: _("Outline Color Picker");
          }

          $GradiaFontDropdown font_dropdown {
            width-request: 160;
            font-changed => $on_font_changed();
          }
        };
      }
    };
  }
}

