<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>@APP_ID@</id>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0-or-later</project_license>
	<supports>
		<control>pointing</control>
		<control>keyboard</control>
		<control>touch</control>
	</supports>
	<name>Klipo</name>
	<summary>Take, annotate and copy screenshots, record your screen</summary>
	<launchable type="desktop-id">@APP_ID@.desktop</launchable>
	<description>
		<p>Klipo is a fast screenshot tool: press a shortcut, select an area, annotate it and copy it to the clipboard, without ever having to save a file.</p>
		<p>Key features:</p>
		<ul>
			<li>Area, window and full screen capture through the desktop portal</li>
			<li>Annotations that stay editable: arrows, shapes, text, highlighter, numbered steps and censoring</li>
			<li>One-key tool shortcuts, tabs and a compact editor</li>
			<li>Screen recording to MP4, WebM or GIF, with sound and hardware encoding</li>
			<li>Optional backgrounds, padding and shadows</li>
			<li>Text recognition and quick upload</li>
		</ul>
		<p>Klipo is a fork of Gradia by Alexander Vanhee.</p>
	</description>
	<developer id="io.github.waxermaster">
		<name>Wilfred</name>
	</developer>
	<screenshots>
		<screenshot type="default">
			<image>https://raw.githubusercontent.com/waxermaster/Klipo/main/data/screenshots/editor.png</image>
			<caption>Annotating a screenshot</caption>
		</screenshot>
		<screenshot>
			<image>https://raw.githubusercontent.com/waxermaster/Klipo/main/data/screenshots/recording-options.png</image>
			<caption>Screen recording options</caption>
		</screenshot>
		<screenshot>
			<image>https://raw.githubusercontent.com/waxermaster/Klipo/main/data/screenshots/video-editor.png</image>
			<caption>Editing a recording</caption>
		</screenshot>
		<screenshot>
			<image>https://raw.githubusercontent.com/waxermaster/Klipo/main/data/screenshots/preferences.png</image>
			<caption>Preferences</caption>
		</screenshot>
	</screenshots>
	<url type="homepage">@PROJECT_URL@</url>
	<url type="vcs-browser">@VCS_URL@</url>
	<url type="bugtracker">@BUGTRACKER_URL@</url>
	<translation type="gettext">klipo</translation>
	<content_rating type="oars-1.1"/>
	<branding>
		<color type="primary" scheme_preference="light">#ffb3a3</color>
		<color type="primary" scheme_preference="dark">#c41f3a</color>
	</branding>
	<releases>
		<release version="0.1.0" date="2026-10-13">
			<description translate="no">
				<p>First Klipo release, forked from Gradia 1.14.0.</p>
			</description>
		</release>
	</releases>
</component>
